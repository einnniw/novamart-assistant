# Application settings (development environment)
APP_NAME=novamart-assistant
APP_ENV=development
LOG_LEVEL=INFO

# AI Provider Settings (OpenAI)
# Set your real API key in your private shell environment or local .env file.
# NEVER commit a real API key or add secrets to this example file.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
